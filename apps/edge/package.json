{
  "name": "@relaypay/edge",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm audit --package-lock-only --ignore-scripts --audit-level=high",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  },
  "packageManager": "npm@11.19.1"
}
